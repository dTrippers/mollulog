{
  "files": {
    "include": ["app/**/*.tsx", "app/**/*.ts", "test/**/*.ts"],
    "ignore": ["app/graphql/**/*"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noUselessElse": "off"
      }
    }
  }
}
