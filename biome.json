{
  "files": {
    "includes": ["**/app/**/*.tsx", "**/app/**/*.ts", "**/test/**/*.ts", "!**/app/graphql/**/*"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noUselessElse": "off"
      }
    }
  }
}
