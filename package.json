{
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "codegen": "graphql-codegen",
    "dev": "react-router dev --host",
    "cf-typegen": "wrangler types",
    "start": "wrangler dev --persist-to ${WRANGLER_PERSIST_TO:-.wrangler/state}",
    "staging:build": "CLOUDFLARE_ENV=staging react-router build --mode staging",
    "staging:deploy": "pnpm run staging:build && wrangler deploy",
    "prod:build": "CLOUDFLARE_ENV=production react-router build --mode production",
    "prod:deploy": "pnpm run prod:build && wrangler deploy",
    "assets:build": "cd lambda && GOOS=linux GOARCH=amd64 go build -tags lambda.norpc -o build/bootstrap ./assets-metadata",
    "assets:plan": "tofu -chdir=deploy/assets plan",
    "assets:deploy": "tofu -chdir=deploy/assets apply",
    "dev:db:migrate": "wrangler d1 migrations apply --local DB --persist-to ${WRANGLER_PERSIST_TO:-.wrangler/state}",
    "prod:db:migrate": "wrangler d1 migrations apply --remote DB --env production",
    "prod:db:pull": "mkdir -p tmp && wrangler d1 export mollulog --remote --env production --output=tmp/prod-remote-dump.sql && rm -rf ${WRANGLER_PERSIST_TO:-.wrangler/state}/v3/d1/miniflare-D1DatabaseObject && wrangler d1 execute DB --local --persist-to ${WRANGLER_PERSIST_TO:-.wrangler/state} --file=tmp/prod-remote-dump.sql --yes",
    "test": "jest",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome lint --write app test && biome check --write test"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.4.2",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@logtail/edge": "^0.5.8",
    "@react-router/cloudflare": "^7.14.0",
    "@react-router/fs-routes": "^7.14.0",
    "@sentry/browser": "^10.43.0",
    "@sentry/cloudflare": "^10.43.0",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.7.0",
    "fido2-lib": "^3.5.9",
    "graphql": "^16.12.0",
    "hangul-js": "^0.2.6",
    "isbot": "^5.1.32",
    "javascript-lp-solver": "^0.4.24",
    "marked": "^15.0.12",
    "nanoid": "^3.3.11",
    "protobufjs": "^7.5.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-loading-skeleton": "^3.5.0",
    "react-router": "^7.15.0",
    "react-top-loading-bar": "^3.0.2",
    "react-youtube": "^10.1.0",
    "recharts": "^3.8.1",
    "remix-auth": "^3.7.0",
    "remix-auth-github": "^2.0.0",
    "remix-auth-google": "^2.0.0",
    "sanitize-html": "^2.17.0",
    "tailwind-merge": "^3.5.0",
    "urql": "^4.2.2"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/vite-plugin": "^1.31.1",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.3.0",
    "@react-router/dev": "^7.14.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.3.0",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.90.1"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "@remix-run/react": "2.17.4",
      "@remix-run/server-runtime": "2.17.4"
    }
  }
}
