{
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "codegen": "graphql-codegen",
    "dev": "react-router dev --host",
    "cf-typegen": "wrangler types",
    "start": "wrangler dev --persist-to ${WRANGLER_PERSIST_TO:-.wrangler/state}",
    "staging:build": "CLOUDFLARE_ENV=staging react-router build --mode staging",
    "staging:deploy": "pnpm run staging:build && wrangler deploy --config build/server/wrangler.json && wrangler deploy --config dist/cron/wrangler.json",
    "prod:build": "CLOUDFLARE_ENV=production react-router build --mode production",
    "prod:deploy": "bash scripts/production-deploy.sh",
    "prod:deploy:preflight": "bash scripts/production-deploy.sh --preflight-only",
    "assets:build": "cd lambda && GOOS=linux GOARCH=amd64 go build -tags lambda.norpc -o build/bootstrap ./assets-metadata",
    "assets:plan": "terraform -chdir=deploy/assets plan",
    "assets:deploy": "terraform -chdir=deploy/assets apply",
    "cdn:plan": "terraform -chdir=deploy/cdn plan",
    "cdn:deploy": "terraform -chdir=deploy/cdn apply",
    "test": "jest",
    "typecheck": "react-router typegen && tsc",
    "lint": "pnpm run lint:postgres-migrations && biome lint app test && biome check test",
    "lint:fix": "pnpm run lint:postgres-migrations && biome lint --write app test && biome check --write test",
    "lint:postgres-migrations": "node scripts/lint-postgres-migrations.mjs"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@logtail/edge": "^0.5.8",
    "@react-router/cloudflare": "^7.18.2",
    "@react-router/fs-routes": "^7.18.2",
    "@sentry/browser": "^10.63.0",
    "@sentry/cloudflare": "^10.63.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@urql/core": "^6.0.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "fido2-lib": "^3.5.9",
    "graphql": "^16.12.0",
    "hangul-js": "^0.2.6",
    "isbot": "^5.1.44",
    "javascript-lp-solver": "^1.0.3",
    "marked": "^15.0.12",
    "nanoid": "^3.3.17",
    "pg": "^8.22.0",
    "protobufjs": "^8.7.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-loading-skeleton": "^3.5.0",
    "react-router": "^7.18.2",
    "react-top-loading-bar": "^3.0.2",
    "react-youtube": "^10.1.0",
    "recharts": "^3.9.1",
    "remix-auth": "^3.7.0",
    "remix-auth-github": "^2.0.0",
    "remix-auth-google": "^2.0.0",
    "sanitize-html": "^2.17.5",
    "tailwind-merge": "^3.6.0",
    "urql": "^5.0.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/vite-plugin": "^1.43.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^6.2.1",
    "@jest/globals": "^30.4.1",
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "tailwindcss": "^4.3.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
