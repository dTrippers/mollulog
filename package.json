{
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "codegen": "graphql-codegen",
    "dev": "node scripts/local-dev.mjs dev",
    "cf-typegen": "wrangler types",
    "start": "node scripts/local-dev.mjs dev",
    "staging:build": "CLOUDFLARE_ENV=staging react-router build --mode staging",
    "staging:deploy": "pnpm run staging:build && wrangler deploy --config build/server/wrangler.json && wrangler deploy --config dist/cron/wrangler.json",
    "prod:build": "CLOUDFLARE_ENV=production react-router build --mode production",
    "prod:deploy": "bash scripts/production-deploy.sh",
    "prod:deploy:preflight": "bash scripts/production-deploy.sh --preflight-only",
    "assets:build": "cd lambda && GOOS=linux GOARCH=amd64 go build -tags lambda.norpc -o build/bootstrap ./assets-metadata",
    "assets:plan": "terraform -chdir=deploy/assets plan",
    "assets:deploy": "terraform -chdir=deploy/assets apply",
    "cdn:plan": "terraform -chdir=deploy/cdn plan",
    "cdn:deploy": "terraform -chdir=deploy/cdn apply",
    "test": "jest",
    "typecheck": "pnpm run cf-typegen && react-router typegen && tsc",
    "lint": "pnpm run lint:postgres-migrations && biome lint app test && biome check test",
    "lint:fix": "pnpm run lint:postgres-migrations && biome lint --write app test && biome check --write test",
    "lint:postgres-migrations": "node scripts/lint-postgres-migrations.mjs",
    "dev:doctor": "node scripts/local-dev.mjs doctor",
    "dev:db:status": "node scripts/local-dev.mjs db:status",
    "dev:db:migrate": "node scripts/local-dev.mjs db:migrate",
    "test:local-dev": "node --test scripts/local-dev.test.mjs",
    "student-state:migration": "node scripts/student-state-migration.mjs"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@logtail/edge": "^0.5.12",
    "@react-router/cloudflare": "^7.18.4",
    "@react-router/fs-routes": "^7.18.4",
    "@sentry/browser": "^10.76.2",
    "@sentry/cloudflare": "^10.76.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@urql/core": "^6.0.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fido2-lib": "^3.5.9",
    "graphql": "^16.14.2",
    "hangul-js": "^0.2.6",
    "isbot": "^5.2.2",
    "javascript-lp-solver": "^1.0.3",
    "marked": "^15.0.12",
    "nanoid": "^3.3.20",
    "pg": "^8.23.1",
    "protobufjs": "^8.8.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-loading-skeleton": "^3.5.0",
    "react-router": "^7.18.4",
    "react-top-loading-bar": "^3.0.2",
    "react-youtube": "^10.1.0",
    "recharts": "^3.10.1",
    "remix-auth": "^3.7.0",
    "remix-auth-github": "^2.0.0",
    "remix-auth-google": "^2.0.0",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0",
    "urql": "^5.0.4"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "2.5.2",
    "@cloudflare/vite-plugin": "^1.43.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@jest/globals": "^30.5.2",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
