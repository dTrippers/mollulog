{
  "name": "mollulog-cron",
  "compatibility_date": "2025-06-17",  // https://developers.cloudflare.com/workers/platform/compatibility-dates
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/cron.ts",
  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "destinations": ["axiom-traces"],
      "persist": true
    },
    "logs": {
      "head_sampling_rate": 1,
      "destinations": ["axiom-logs"],
      "persist": true
    }
  },
  "triggers": {
    "crons": ["* * * * *", "*/10 * * * *"]
  },

  "kv_namespaces": [
    { "binding": "KV_CACHE", "id": "local_KV_CACHE" }
  ],
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "0531527296514c808ba518ad5cbaa3d2" }
  ],
  "r2_buckets": [
    { "binding": "OCR_UPLOADS", "bucket_name": "mollulog-aoi-uploads-dev" }
  ],
  "queues": {
    "producers": [
      { "binding": "OCR_TASKS", "queue": "mollulog-aoi-tasks-dev" }
    ]
  },
  "vars": {
    "STAGE": "local"
  },

  // Secrets configuration
  // - SERVER_BETTER_STACK_SOURCE_TOKEN
  // - SERVER_SENTRY_DSN
  "env": {
    "staging": {
      // Do not duplicate the production cache warm and YouTube sync load on
      // the same schedule.
      "triggers": {
        "crons": []
      },
      "vars": {
        "STAGE": "staging"
      },
      "kv_namespaces": [
        { "binding": "KV_CACHE", "id": "b957557c116a41168c42136666ef5808" }
      ],
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "0531527296514c808ba518ad5cbaa3d2" }
      ],
      "r2_buckets": [
        { "binding": "OCR_UPLOADS", "bucket_name": "mollulog-aoi-uploads-prod" }
      ],
      "queues": {
        "producers": [
          { "binding": "OCR_TASKS", "queue": "mollulog-aoi-tasks-prod" }
        ]
      }
    },
    "production": {
      "vars": {
        "STAGE": "prod"
      },
      "kv_namespaces": [
        { "binding": "KV_CACHE", "id": "a613bc84ffeb4362b3deaa05c617a7b3"}
      ],
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "0531527296514c808ba518ad5cbaa3d2" }
      ],
      "r2_buckets": [
        { "binding": "OCR_UPLOADS", "bucket_name": "mollulog-aoi-uploads-prod" }
      ],
      "queues": {
        "producers": [
          { "binding": "OCR_TASKS", "queue": "mollulog-aoi-tasks-prod" }
        ]
      },
      "logpush": true
    }
  }
}
